# Telegram Bot Token (Get it from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"

# Gemini API Key (Get it from Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"

# SQLite Database Connection URL for Prisma
DATABASE_URL="file:./dev.db"

# Agent Group/Chat ID to receive hot lead notifications.
# (If not configured, the bot will simulate notifications in the log or direct message)
AGENT_GROUP_CHAT_ID="-100123456789"
